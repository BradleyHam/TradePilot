# Trade Pilot environment — copy to .env.local and fill in real values.
# .env.local is gitignored.

# Public Supabase config — used by the browser client.
# Found in Supabase dashboard → Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_ME

# Service-role key — bypasses RLS. Used by server-side scripts (the
# importer) AND by the website-enquiry webhook route. Never imported by
# client components.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────
# Website enquiry webhook (POST /api/webhooks/website-enquiry)
# ─────────────────────────────────────────────────────────────────────────
# Shared secret — the painterswanaka.co.nz contact-form handler must send
# this in the `x-webhook-secret` header. Generate with:
#   openssl rand -hex 32
# WEBSITE_WEBHOOK_SECRET=

# Which business inbound website enquiries should be added to. Look up in
# Supabase → Table editor → businesses → copy the id of Lakeside Painting.
# TRADEPILOT_BUSINESS_ID=

# ─────────────────────────────────────────────────────────────────────────
# Anthropic API key (POST /api/parse-bill)
# ─────────────────────────────────────────────────────────────────────────
# Used server-side by the bill-PDF parser to extract supplier/amount/GST
# from uploaded invoices. NEVER expose as NEXT_PUBLIC_ — that would ship
# the key to the browser. Get one from console.anthropic.com → API Keys.
# At ~$0.005 per bill (Haiku 4.5), $5 of credit is ~1000 bills.
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────
# Inbound-bill webhook (POST /api/webhooks/inbound-bill)
# ─────────────────────────────────────────────────────────────────────────
# Shared secret expected in the `x-webhook-secret` header on every
# incoming request. The mail-receiver service (e.g. CloudMailin) must be
# configured to send this header. Generate with:
#   openssl rand -hex 32
# INBOUND_BILL_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Facebook posting (Marketing tab → "Post to Facebook")
# ─────────────────────────────────────────────────────────────────────────
# Posts a finished job's photos + caption to the Lakeside Facebook Page via
# the Graph API. Runs LOCALLY (npm run dev) — converts photos with macOS sips.
# Drafting captions needs no setup; only the actual POST needs these.
#
# Get a never-expiring Page token (one-time, ~10 min):
#   1. developers.facebook.com/apps → Create App → "Other" → Business.
#   2. Tools → Graph API Explorer → add permission `pages_manage_posts`
#      (+ `pages_read_engagement`) → Generate Access Token → pick your Page.
#   3. Settings → Basic → copy the App Secret, then exchange + fetch the Page
#      token (the README / chat has the exact two curl commands).
#   4. Debug the final token at developers.facebook.com/tools/debug/accesstoken —
#      it should say Expires: Never.
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional — pin the Graph API version (defaults to v23.0):
# FACEBOOK_GRAPH_VERSION=v23.0
# Optional — base URL used to build the project link in captions (default below):
# PAINTERS_WANAKA_SITE_URL=https://painterswanaka.co.nz
# Instagram posting reuses FACEBOOK_PAGE_ACCESS_TOKEN; the token needs
# instagram_basic + instagram_content_publish granted, and the IG professional
# account linked to the Page. scripts/facebook-token-setup.ts discovers and
# writes this id automatically (optional — auto-discovered at post time too):
# INSTAGRAM_ACCOUNT_ID=
